{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "requireBranch": "main"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "assets": [
      "android/app/build/outputs/apk/release/tunehub-*-v${version}.apk",
      "ios/build/tunehub-v${version}.ipa"
    ]
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": [
      "node scripts/sync-versions.js ${version}",
      "yarn build-android",
      "yarn build-ios"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": { "name": "conventionalcommits" },
      "infile": "CHANGELOG.md"
    }
  }
}
