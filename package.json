{
  "name": "tunehub",
  "main": "expo-router/entry",
  "version": "1.2.1",
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/query-persist-client-core": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "jiosaavn-sdk": "^1.1.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-ota": "0.14.1",
    "react-native-nitro-player": "^1.7.0-alpha.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "^3.0.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.14",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.7",
    "release-it": "^21.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "perf": "EXPO_PUBLIC_PERF_RUN=screens REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --clear",
    "perf:player": "EXPO_PUBLIC_PERF_RUN=player REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --clear",
    "perf:tour": "EXPO_PUBLIC_PERF_RUN=tour REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --clear",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "release-it",
    "build-android": "bash scripts/build-android.sh",
    "build-ios": "bash scripts/build-ios.sh",
    "ota": "bash scripts/publish-ota.sh"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.3.0",
    "react-native-nitro-modules": "$react-native-nitro-modules"
  }
}
